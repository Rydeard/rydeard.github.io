---
import { Image, getImage } from 'astro:assets';
import hallSummer from '../assets/wedding/hall-summer.jpg';
import hallLake from '../assets/wedding/hall-lake.jpg';
import bridgeFountain from '../assets/wedding/bridge-fountain.jpg';
import hallCrop from '../assets/wedding/hall-crop.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const venue = 'Waterton Park Hotel';
const address = 'Walton Hall, Walton, Wakefield, WF2 6PW';
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${venue}, ${address}`);

// Freely licensed photos from Wikimedia Commons (attribution required).
const slides = [
  { src: hallSummer, alt: 'Walton Hall on its island, with the iron footbridge across the lake in summer', pos: '48% 50%' },
  { src: hallLake, alt: 'Walton Hall seen across the lake', pos: '58% 50%' },
  { src: bridgeFountain, alt: 'The iron footbridge and fountain on the lake at Walton Hall', pos: '40% 50%' },
];
const credits = [
  { author: 'Dave.Dunford', url: 'https://commons.wikimedia.org/wiki/File:Bridge_and_medieval_gateway_at_Walton_Hall.jpg', license: 'CC BY-SA 4.0' },
  { author: 'Gordon Hatton', url: 'https://commons.wikimedia.org/wiki/File:Walton_Hall_from_Lake.jpg', license: 'CC BY-SA 2.0' },
  { author: 'Gordon Hatton', url: 'https://commons.wikimedia.org/wiki/File:Bridge_at_Walton_Hall_-_geograph.org.uk_-_6374608.jpg', license: 'CC BY-SA 2.0' },
];

const og = await getImage({ src: hallCrop, width: 1200, format: 'jpg' });
const ogUrl = Astro.site ? new URL(og.src, Astro.site).href : og.src;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Save the Date — Rachel & Luke</title>
    <meta name="description" content={`Rachel & Luke are getting married on Saturday 17th June 2028 at ${venue}, Wakefield.`} />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="Save the Date — Rachel & Luke" />
    <meta property="og:description" content={`Saturday 17th June 2028 · ${venue}, Wakefield`} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1d1a17" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="slides">
      {slides.map((s, i) => (
        <Image
          src={s.src}
          alt={s.alt}
          widths={[640, 1024, 1600, 2000]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          class:list={['slide', { active: i === 0 }]}
          style={`object-position: ${s.pos}`}
        />
      ))}
    </div>
    <div class="veil" aria-hidden="true"></div>

    <main class="stage">
      <header class="top">
        <h1 class="script save">Save the Date</h1>
        <p class="lead">for the wedding of</p>
      </header>

      <section class="bottom">
        <p class="names">Rachel <span class="amp">&amp;</span> Luke</p>
        <div class="flourish" aria-hidden="true"><span></span><i></i><span></span></div>
        <p class="date"><time datetime="2028-06-17">Saturday 17th June 2028</time></p>
        <p class="venue">
          <span class="nowrap">{venue},</span> <span class="nowrap">Wakefield,</span> <span class="nowrap">West Yorkshire</span>
        </p>
        <p class="follow"><span class="script">formal invitation</span> to follow</p>
        <nav class="links">
          <a href={mapUrl} target="_blank" rel="noopener">View on map</a>
          <span aria-hidden="true">·</span>
          <a href={`${base}wedding.ics`} download>Add to calendar</a>
        </nav>
      </section>
    </main>

    <footer class="credits">
      Photographs by{' '}<a href={credits[0].url} target="_blank" rel="noopener" title={credits[0].license}>{credits[0].author}</a>{' '}&amp;{' '}<a href={credits[1].url} target="_blank" rel="noopener" title={credits[1].license}>{credits[1].author}</a>{' '}· CC BY-SA via{' '}<a href={credits[2].url} target="_blank" rel="noopener" title={credits[2].license}>Wikimedia Commons</a>
    </footer>

    <script>
      // Slow crossfade between venue photographs.
      const slides = [...document.querySelectorAll<HTMLElement>('.slide')];
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!still && slides.length > 1) {
        let current = 0;
        setInterval(() => {
          slides[current].classList.remove('active');
          current = (current + 1) % slides.length;
          slides[current].classList.add('active');
        }, 8000);
      }
    </script>

    <style is:global>
      :root {
        --ivory: #fbf6ee;
        --ivory-soft: rgba(251, 246, 238, 0.86);
        --shadow: 0 1px 2px rgba(0, 0, 0, 0.35), 0 2px 18px rgba(0, 0, 0, 0.35);
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: #1d1a17; }
      body {
        min-height: 100svh;
        font-family: 'Cormorant Garamond', Georgia, serif;
        color: var(--ivory);
        text-shadow: var(--shadow);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      .slides, .veil { position: fixed; inset: 0; }
      .slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.08);
        transition: opacity 2.4s ease, transform 12s ease-out;
      }
      .slide.active { opacity: 1; transform: scale(1); }

      /* Darken only the top and bottom, leaving the middle of the photo clear. */
      .veil {
        background:
          linear-gradient(to bottom, rgba(20, 16, 12, 0.55) 0%, rgba(20, 16, 12, 0.12) 26%, transparent 40%,
            transparent 50%, rgba(20, 16, 12, 0.2) 62%, rgba(20, 16, 12, 0.72) 100%);
      }

      .stage {
        position: relative;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        text-align: center;
        padding: max(2.5rem, env(safe-area-inset-top)) 16px max(3.25rem, calc(env(safe-area-inset-bottom) + 2.5rem));
        gap: 2rem;
      }

      .script { font-family: 'Pinyon Script', cursive; font-weight: 400; }
      .save {
        margin: 0;
        font-size: clamp(3rem, 11vw, 5.5rem);
        line-height: 1.1;
        animation: rise 1.6s ease both;
      }
      .lead {
        margin: 0.4rem 0 0;
        font-style: italic;
        font-size: clamp(1.05rem, 3.6vw, 1.35rem);
        letter-spacing: 0.16em;
        animation: rise 1.6s 0.3s ease both;
      }

      .bottom { animation: rise 1.6s 0.6s ease both; max-width: 40rem; }
      .names {
        margin: 0;
        font-weight: 500;
        font-size: clamp(1.9rem, 7.5vw, 3.2rem);
        letter-spacing: 0.18em;
        text-transform: uppercase;
        line-height: 1.15;
      }
      .amp { font-style: italic; font-weight: 400; text-transform: none; letter-spacing: 0; padding: 0 0.08em; }

      .flourish { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin: 1rem auto 0.9rem; }
      .flourish span { width: clamp(3rem, 14vw, 5rem); height: 1px; background: var(--ivory-soft); box-shadow: 0 0 6px rgba(0, 0, 0, 0.3); }
      .flourish i { width: 6px; height: 6px; background: var(--ivory); transform: rotate(45deg); box-shadow: 0 0 6px rgba(0, 0, 0, 0.3); }

      .date {
        margin: 0;
        font-size: clamp(1.2rem, 4.6vw, 1.7rem);
        letter-spacing: 0.14em;
        font-variant-numeric: lining-nums;
      }
      .venue {
        margin: 0.35rem 0 0;
        font-style: italic;
        font-size: clamp(1.1rem, 4.2vw, 1.45rem);
        letter-spacing: 0.08em;
      }
      .nowrap { white-space: nowrap; }
      .follow {
        margin: 1.4rem 0 0;
        font-size: clamp(1.05rem, 3.8vw, 1.25rem);
        letter-spacing: 0.08em;
      }
      .follow .script { font-size: 1.6em; letter-spacing: 0; padding-right: 0.15em; }

      .links {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        margin-top: 1.5rem;
        font-size: 0.9rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ivory-soft);
      }
      .links a { color: inherit; text-decoration: none; border-bottom: 1px solid rgba(251, 246, 238, 0.45); padding-bottom: 2px; }
      .links a:hover { color: var(--ivory); border-color: var(--ivory); }

      .credits {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 0.5rem 1rem max(0.6rem, env(safe-area-inset-bottom));
        text-align: center;
        font-size: 0.78rem;
        font-style: italic;
        color: rgba(251, 246, 238, 0.6);
      }
      .credits a { color: inherit; text-decoration: none; }
      .credits a:hover { text-decoration: underline; }

      @media (max-width: 480px) { .stage { padding-bottom: max(4rem, calc(env(safe-area-inset-bottom) + 3.25rem)); } }

      @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
      @media (prefers-reduced-motion: reduce) {
        .slide, .save, .lead, .bottom { transition: none; animation: none; transform: none; }
      }
    </style>
  </body>
</html>
