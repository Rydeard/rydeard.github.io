---
import { Image, getImage } from 'astro:assets';
import hall from '../assets/wedding/hall-crop.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const venue = 'Waterton Park Hotel';
const place = 'Wakefield, West Yorkshire';
const address = 'Walton Hall, Walton, Wakefield, WF2 6PW';
const mapUrl = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(`${venue}, ${address}`);

const og = await getImage({ src: hall, width: 1200, format: 'jpg' });
const ogUrl = Astro.site ? new URL(og.src, Astro.site).href : og.src;

// Paper grain as an inline SVG noise texture.
const grain = `url("data:image/svg+xml,${encodeURIComponent(
  "<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .35  0 0 0 0 .28  0 0 0 0 .2  0 0 0 .5 0'/></filter><rect width='100%' height='100%' filter='url(#n)'/></svg>"
)}")`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Save the Date — Luke & Rachel</title>
    <meta name="description" content={`Luke & Rachel are getting married on Saturday 17th June 2028 at ${venue}, ${place}.`} />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="Save the Date — Luke & Rachel" />
    <meta property="og:description" content={`Saturday 17th June 2028 · ${venue}, ${place}`} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#dfe5ec" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Pinyon+Script&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="card-shadow">
      <main class="card" style={`--grain: ${grain}`}>
        <h1 class="script save">Save the Date</h1>
        <p class="lead">for<br />the wedding of</p>

        <figure class="painting">
          <Image
            src={hall}
            alt="Walton Hall, home of Waterton Park Hotel, on its island in the lake"
            widths={[480, 800, 1200]}
            sizes="(max-width: 560px) 80vw, 420px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>

        <p class="names">Luke <span class="amp">&amp;</span> Rachel</p>
        <p class="date"><time datetime="2028-06-17">17.06.2028</time></p>
        <p class="venue"><span class="nowrap">{venue},</span> <span class="nowrap">Wakefield,</span> <span class="nowrap">West Yorkshire</span></p>

        <p class="follow"><span class="script">formal invitation</span><br />to follow</p>
      </main>
    </div>

    <nav class="links">
      <a href={mapUrl} target="_blank" rel="noopener">View on map</a>
      <span aria-hidden="true">·</span>
      <a href={`${base}wedding.ics`} download>Add to calendar</a>
    </nav>

    <footer class="credits">
      Photo:{' '}<a href="https://commons.wikimedia.org/wiki/File:Bridge_and_medieval_gateway_at_Walton_Hall.jpg" target="_blank" rel="noopener">Dave.Dunford</a>, CC BY-SA 4.0, via Wikimedia Commons (cropped)
    </footer>

    <style is:global>
      :root {
        --paper: #f2e8dc;
        --ink: #2e2724;
        --ink-soft: #5a4f49;
        --envelope: #dfe5ec;
        --scoop: clamp(26px, 7vw, 40px);
        color-scheme: light;
      }
      * { box-sizing: border-box; }
      html { background: var(--envelope); }
      body {
        margin: 0;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        padding: max(24px, env(safe-area-inset-top)) 16px max(20px, env(safe-area-inset-bottom));
        font-family: 'Cormorant Garamond', Georgia, serif;
        color: var(--ink);
        background:
          radial-gradient(ellipse at 50% 35%, #eef2f6 0%, transparent 70%),
          var(--envelope);
        -webkit-font-smoothing: antialiased;
      }

      .card-shadow {
        width: min(500px, 100%);
        filter: drop-shadow(0 1px 1px rgba(60, 50, 40, 0.18)) drop-shadow(0 18px 30px rgba(60, 70, 90, 0.18));
        animation: arrive 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }
      @keyframes arrive { from { opacity: 0; transform: translateY(18px) rotate(-0.6deg); } }

      /* Bracket-style die cut: concave scoops at each corner. */
      .card {
        position: relative;
        padding: clamp(2.5rem, 9vw, 3.75rem) clamp(1.5rem, 7vw, 3.25rem) clamp(2.25rem, 8vw, 3.25rem);
        text-align: center;
        background: var(--paper);
        -webkit-mask:
          radial-gradient(circle at 0 0, transparent var(--scoop), #000 calc(var(--scoop) + 0.5px)) top left / 51% 51% no-repeat,
          radial-gradient(circle at 100% 0, transparent var(--scoop), #000 calc(var(--scoop) + 0.5px)) top right / 51% 51% no-repeat,
          radial-gradient(circle at 0 100%, transparent var(--scoop), #000 calc(var(--scoop) + 0.5px)) bottom left / 51% 51% no-repeat,
          radial-gradient(circle at 100% 100%, transparent var(--scoop), #000 calc(var(--scoop) + 0.5px)) bottom right / 51% 51% no-repeat;
        mask:
          radial-gradient(circle at 0 0, transparent var(--scoop), #000 calc(var(--scoop) + 0.5px)) top left / 51% 51% no-repeat,
          radial-gradient(circle at 100% 0, transparent var(--scoop), #000 calc(var(--scoop) + 0.5px)) top right / 51% 51% no-repeat,
          radial-gradient(circle at 0 100%, transparent var(--scoop), #000 calc(var(--scoop) + 0.5px)) bottom left / 51% 51% no-repeat,
          radial-gradient(circle at 100% 100%, transparent var(--scoop), #000 calc(var(--scoop) + 0.5px)) bottom right / 51% 51% no-repeat;
      }
      .card::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: var(--grain);
        opacity: 0.22;
        mix-blend-mode: multiply;
        pointer-events: none;
      }
      .card > * { position: relative; }

      .script { font-family: 'Pinyon Script', cursive; font-weight: 400; }
      .save {
        margin: 0;
        font-size: clamp(2.9rem, 13vw, 4.4rem);
        line-height: 1.1;
        letter-spacing: 0.01em;
      }
      .lead {
        margin: 0.9rem 0 0;
        font-style: italic;
        font-size: clamp(1rem, 3.8vw, 1.15rem);
        letter-spacing: 0.14em;
        line-height: 1.55;
        color: var(--ink-soft);
      }

      .painting { margin: clamp(1.25rem, 5vw, 2rem) auto; width: min(100%, 400px); }
      .painting img {
        display: block;
        width: 100%;
        height: auto;
        mix-blend-mode: multiply;
        filter: saturate(0.82) sepia(0.12) contrast(0.92) brightness(1.08);
        -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 58%, transparent 100%);
        mask-image: radial-gradient(ellipse 50% 50% at 50% 50%, #000 58%, transparent 100%);
      }

      .names {
        margin: 0;
        font-weight: 500;
        font-size: clamp(1.45rem, 6vw, 1.9rem);
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .amp { font-style: italic; font-weight: 400; text-transform: none; letter-spacing: 0; padding: 0 0.1em; }
      .date {
        margin: 1.1rem 0 0;
        font-size: clamp(1.2rem, 4.8vw, 1.45rem);
        letter-spacing: 0.22em;
        font-variant-numeric: lining-nums;
      }
      .venue {
        margin: 0.35rem 0 0;
        font-style: italic;
        font-size: clamp(1.05rem, 4.2vw, 1.3rem);
        letter-spacing: 0.08em;
      }
      .nowrap { white-space: nowrap; }
      .follow {
        margin: clamp(1.75rem, 6vw, 2.5rem) 0 0;
        font-size: clamp(1.05rem, 4vw, 1.2rem);
        letter-spacing: 0.08em;
        line-height: 1.1;
      }
      .follow .script { font-size: 1.75em; letter-spacing: 0; }

      .links {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        font-size: 0.95rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
        animation: arrive 1.1s 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }
      .links a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid rgba(46, 39, 36, 0.35);
        padding-bottom: 1px;
      }
      .links a:hover { color: var(--ink); border-color: var(--ink); }

      .credits { font-size: 0.75rem; color: #7d8794; text-align: center; letter-spacing: 0.02em; }
      .credits a { color: inherit; }

      @media (prefers-reduced-motion: reduce) {
        .card-shadow, .links { animation: none; }
      }
    </style>
  </body>
</html>
